# Remote state: S3 with native S3 lockfile locking (technical-spec.md#terraform-state-backend).
#
# The bucket name contains the AWS account ID (petclinic-terraform-state-{account-id}),
# so it is supplied at init time via partial configuration instead of being hardcoded:
#
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is generated by scripts/bootstrap-state.sh (see backend.hcl.example).
terraform {
  backend "s3" {
    key          = "petclinic/dev/terraform.tfstate"
    region       = "ap-south-1"
    use_lockfile = true # S3 native locking (Terraform >= 1.10), replaces DynamoDB
    encrypt      = true
  }
}

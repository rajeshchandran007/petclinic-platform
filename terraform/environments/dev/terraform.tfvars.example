# Copy to terraform.tfvars (gitignored) and adjust. Never put secrets here.
aws_region  = "ap-south-1"
environment = "dev"
project     = "petclinic"

# Networking (technical-spec.md#cidr-allocation) — defaults already match the spec
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
availability_zones  = ["ap-south-1a", "ap-south-1b"]

# EKS (technical-spec.md#eks-cluster)
eks_cluster_version = "1.35"
# Restrict the public API endpoint to your own IP(s): curl -s https://checkip.amazonaws.com
eks_public_access_cidrs = ["203.0.113.10/32"]
# Extra cluster admins (IAM users/roles, not root). The Terraform caller is added automatically.
eks_cluster_admin_principal_arns = []

# DNS (technical-spec.md#dns-and-ingress) — a domain you own; delegate the
# output dns_zone_name_servers at your registrar before the cert can validate.
domain_name = "example.com"
# true (default) blocks apply until ACM issues the cert, which needs the NS
# delegation to be live. If the zone is new: apply once with false, set the NS
# records at your registrar, then apply again with true.
wait_for_certificate_validation = true
# After the Ingress has created petclinic-dev-alb (PETPLAT-31):
create_alb_dns_record = false
